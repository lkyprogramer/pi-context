{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-context.dev/schemas/runtime-cursor.schema.json",
  "title": "RuntimeCursor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspaceId",
    "sessionId",
    "leafId",
    "lineageHash",
    "modelKey"
  ],
  "properties": {
    "workspaceId": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "leafId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "lineageHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "modelKey": {
      "type": "string",
      "minLength": 1
    }
  }
}
