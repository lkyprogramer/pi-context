{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CostMetrics",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "runId": {
      "type": "string"
    },
    "scenarioId": {
      "type": "string"
    },
    "armId": {
      "type": "string"
    },
    "inputTokens": {
      "type": "integer",
      "minimum": 0
    },
    "outputTokens": {
      "type": "integer",
      "minimum": 0
    },
    "cacheReadTokens": {
      "type": "integer",
      "minimum": 0
    },
    "cacheWriteTokens": {
      "type": "integer",
      "minimum": 0
    },
    "providerCost": {
      "type": "number",
      "minimum": 0
    },
    "hookLatencyMs": {
      "type": "number",
      "minimum": 0
    },
    "compactionLatencyMs": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "runId",
    "scenarioId",
    "armId",
    "inputTokens",
    "outputTokens",
    "cacheReadTokens",
    "cacheWriteTokens",
    "providerCost",
    "hookLatencyMs",
    "compactionLatencyMs"
  ]
}
