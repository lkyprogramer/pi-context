{
  "kind": "protocol-test-vectors-not-product-results",
  "cases": [
    {
      "id": "F01-first-exposure",
      "input": {
        "successfulRequests": 0,
        "text": "\nDO_NOT_CHANGE_HTTP_PATHS"
      },
      "expect": {
        "transformAllowed": false,
        "tailPreserved": true
      }
    },
    {
      "id": "F02-image",
      "input": {
        "content": [
          {
            "type": "text",
            "text": "inspect this"
          },
          {
            "type": "image",
            "mimeType": "image/png",
            "data": "iVBORw0KGgo="
          }
        ],
        "budgetTokens": 500
      },
      "expect": {
        "imagePreserved": true,
        "mayClaimFits": false
      },
      "note": "invalid/truncated PNG payload is an opaque-preservation vector, not an image decode success fixture"
    },
    {
      "id": "F03-branch",
      "input": {
        "ancestors": [
          "a",
          "b"
        ],
        "matches": [
          {
            "entry": "sibling",
            "score": 99
          },
          {
            "entry": "b",
            "score": 1
          }
        ],
        "limit": 1
      },
      "expect": {
        "entries": [
          "b"
        ]
      }
    },
    {
      "id": "F04-failed-request",
      "input": {
        "httpStatus": 200,
        "streamOutcome": "error"
      },
      "expect": {
        "exposed": false
      }
    },
    {
      "id": "F05-incomplete-batch",
      "input": {
        "callIds": [
          "c1",
          "c2"
        ],
        "resultIds": [
          "c1"
        ]
      },
      "expect": {
        "transformAllowed": false
      }
    },
    {
      "id": "F06-stale-plan",
      "input": {
        "planGeneration": 1,
        "currentGeneration": 2
      },
      "expect": {
        "applied": false
      }
    },
    {
      "id": "F07-wrong-ack",
      "input": {
        "expectedHash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "actualHash": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      },
      "expect": {
        "committed": false
      }
    },
    {
      "id": "F08-utf8",
      "input": {
        "text": "你好🙂\r\nretry\n",
        "maxBytes": 7
      },
      "expect": {
        "allPagesReassemble": true,
        "splitCodepoint": false
      }
    },
    {
      "id": "F09-unknown",
      "input": {
        "content": [
          {
            "type": "vendor-object",
            "signature": "opaque",
            "payload": {
              "a": 1
            }
          }
        ]
      },
      "expect": {
        "deepEqualPreserved": true
      }
    },
    {
      "id": "F10-no-price",
      "input": {
        "inputTokens": 500,
        "price": null
      },
      "expect": {
        "monetaryCost": null
      }
    },
    {
      "id": "F11-budget",
      "input": {
        "protectedTokens": 10000,
        "optionalBudget": 500
      },
      "expect": {
        "protectedKept": true,
        "reason": "budget-unachievable-without-loss"
      }
    },
    {
      "id": "F12-recovery",
      "input": {
        "c1ProtocolSuccess": true,
        "actualModelReadCall": false
      },
      "expect": {
        "c2": "unproven"
      }
    }
  ]
}
