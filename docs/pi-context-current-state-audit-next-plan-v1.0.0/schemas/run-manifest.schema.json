{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "runId",
    "commit",
    "tree",
    "dirty",
    "model",
    "configDigest",
    "corpus",
    "arms",
    "files"
  ],
  "properties": {
    "runId": {
      "type": "string"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "tree": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "dirty": {
      "const": false
    },
    "model": {
      "type": "object"
    },
    "configDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "corpus": {
      "type": "object"
    },
    "arms": {
      "type": "array"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  },
  "additionalProperties": true
}
