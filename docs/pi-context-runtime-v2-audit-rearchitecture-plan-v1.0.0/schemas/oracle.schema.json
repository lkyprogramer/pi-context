{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "caseId",
    "clusterId",
    "facts",
    "actions"
  ],
  "properties": {
    "caseId": {
      "type": "string"
    },
    "clusterId": {
      "type": "string"
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "expected",
          "witnesses"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "expected": {},
          "witnesses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "sourceId",
                "quote"
              ],
              "properties": {
                "sourceId": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
