{
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "type": "module",
  "scripts": {
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:acceptance": "vitest run --config vitest.acceptance.config.ts",
    "test:packed": "vitest run --config vitest.packed.config.ts",
    "test:live": "vitest run --workspace vitest.live-paired-w2.workspace.ts",
    "test:live:w5": "vitest run --workspace vitest.live-w5-lanes.workspace.ts",
    "test:live-smoke": "vitest run --config vitest.live-smoke.config.ts",
    "test:publication": "vitest run --config vitest.publication.config.ts",
    "format:check": "node scripts/ci/format-lint.mjs",
    "oracle:validate": "node scripts/ci/oracle-validation.mjs",
    "check:all": "pnpm check:boundaries && pnpm typecheck && pnpm test:unit",
    "w1:gate": "node scripts/run-w1-gate.mjs",
    "w2:gate": "node scripts/run-w2-gate.mjs",
    "live:verify": "node scripts/run-live-verification.mjs",
    "live:compact": "node scripts/run-live-compact.mjs",
    "live:w2-paired": "node scripts/run-live-paired-w2.mjs",
    "perf:spikes": "node scripts/run-performance-spikes.mjs",
    "security:suite": "vitest run tests/security --config vitest.unit.config.ts",
    "compat:scan": "node scripts/check-public-pi-imports.mjs",
    "compat:lock": "node scripts/install-pi-version.mjs",
    "gate:mvp": "node scripts/gates/deterministic-mvp.mjs",
    "gate:semantic": "node scripts/gates/semantic-beta.mjs",
    "benchmark:corpus:verify": "node scripts/benchmark/corpus-verify.mjs",
    "benchmark:corpus:v3:verify": "node scripts/benchmark/freeze-corpus-v3.mjs --verify",
    "benchmark:w2:live-smoke": "node scripts/benchmark/w2-live-smoke.mjs",
    "benchmark:w2:publication": "node scripts/benchmark/w2-publication.mjs",
    "benchmark:trace:freeze": "node scripts/benchmark/run-vitest.mjs packages/benchmark/test/trace-freeze.test.ts",
    "benchmark:w2:smoke": "node scripts/benchmark/run-vitest.mjs packages/benchmark/test/arms-identity.test.ts",
    "benchmark:reader:smoke": "node scripts/benchmark/run-vitest.mjs packages/benchmark/test/reader-lane.test.ts",
    "benchmark:closed-loop:smoke": "node scripts/benchmark/run-vitest.mjs packages/benchmark/test/closed-loop.test.ts",
    "benchmark:integrity:verify": "node scripts/benchmark/run-vitest.mjs packages/benchmark/test/scoring/leaks.test.ts packages/benchmark/test/scoring/integrity.test.ts",
    "benchmark:economics:verify": "node scripts/benchmark/run-vitest.mjs packages/benchmark/test/economics-pairing.test.ts",
    "benchmark:bundle:verify": "node scripts/benchmark/run-vitest.mjs packages/benchmark/test/bundle-verify.test.ts && python3 scripts/benchmark/verify_run_bundle.py artifacts/runs/immutable-policy/example/bundle.json",
    "benchmark:w2:boundary": "node scripts/gates/deterministic-v3.mjs",
    "benchmark:w2:natural-threshold": "node scripts/gates/deterministic-v3.mjs",
    "benchmark:w2:overflow": "node scripts/gates/deterministic-v3.mjs",
    "benchmark:w2:recursive": "node scripts/gates/deterministic-v3.mjs",
    "benchmark:fault-security": "node scripts/gates/deterministic-v3.mjs",
    "benchmark:performance-cache": "node scripts/gates/deterministic-v3.mjs",
    "gate:deterministic-v3": "node scripts/gates/deterministic-v3.mjs",
    "release:verify": "pnpm vitest run tests/release/package-artifact.test.ts --config vitest.publication.config.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@pcr/benchmark": "workspace:*",
    "@pcr/contracts": "workspace:*",
    "@pcr/core": "workspace:*",
    "@pcr/pi-adapter": "workspace:*",
    "@pcr/runtime": "workspace:*",
    "@pcr/storage-node": "workspace:*",
    "@types/node": "^22.18.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4",
    "jiti": "2.7.0",
    "pi-context-runtime": "workspace:*"
  }
}
