{
  "name": "pi-context",
  "version": "5.0.0-dev.0",
  "private": true,
  "description": "Native-first evidence context plugin for official Pi 0.85.1",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.15.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/extension.js"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "build:v5": "pnpm exec tsc -p tsconfig.build.json",
    "typecheck": "pnpm exec tsc --noEmit -p tsconfig.build.json",
    "compile": "pnpm typecheck",
    "test": "vitest run --config vitest.config.ts",
    "test:packed": "vitest run test/packed/install.test.ts --config vitest.config.ts",
    "compat:scan": "node scripts/check-public-imports.mjs",
    "eval:g4": "node eval/live-g4.mjs",
    "eval:c2": "node eval/live-c2.mjs",
    "eval:smoke": "pnpm exec tsx eval/smoke.mjs",
    "sandbox:build": "node eval/sandbox/build-image.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "^22.18.0",
    "tsx": "4.19.2",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
